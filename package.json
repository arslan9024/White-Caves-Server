  "description": "White Caves CRM - Backend Server, Prisma & Realtime Microservices",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "ports:check": "npx tsx ../secrets/ports.ts --check",
    "dev": "nodemon",
    "dev:tsx": "tsx watch server/index.ts",
    "dev:dashboard": "cross-env LINDA_TERMINAL_DASHBOARD=true tsx watch server/index.ts",
    "start:dashboard": "cross-env LINDA_TERMINAL_DASHBOARD=true tsx server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "vitest run server/",
    "tunnel:start": "powershell -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1",
    "watchdog:start": "powershell -ExecutionPolicy Bypass -File scripts/server-watchdog.ps1"
  },
