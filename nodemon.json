{
  "watch": ["server", "prisma", "src"],
  "ext": "ts,js,json",
  "ignore": [
    "dist",
    "coverage",
    "node_modules",
    "modules/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "exec": "node ./node_modules/tsx/dist/cli.mjs server/index.ts",
  "events": {
    "restart": "node -e \"process.stdout.write('\\x1Bc')\""
  },
  "signal": "SIGTERM",
  "delay": "250"
}
